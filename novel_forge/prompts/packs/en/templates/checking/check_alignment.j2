{% if scene.owned_revelations | default([]) %}   - Atomic Must-Land Revelations: {{ scene.owned_revelations | join('; ') }}{% endif %}
{% if scene.owned_state_changes | default([]) %}   - Atomic Must-Land State Changes: {{ scene.owned_state_changes | join('; ') }}{% endif %}
{% endfor %}

