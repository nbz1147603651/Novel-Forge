{%- if phase.time_context %} ⏰ {{ phase.time_context }}{% endif -%}
{%- if phase.primary_locations %} 📍 {{ phase.primary_locations | join(' / ') }}{% endif -%}
{%- if phase.key_characters %} 👤 {{ phase.key_characters | join(' / ') }}{% endif -%}
{%- if phase.key_events %} ▸ {{ phase.key_events | join(' / ') }}{% endif %}
{% endfor %}{% endif %}
{% if blueprint.key_turning_points %}

### Key Turning Points
{% for tp in blueprint.key_turning_points %}- Chapter {{ tp.chapter_number }}: {{ tp.description }}{% if tp.location %} (Scene: {{ tp.location }}){% endif %}{% if tp.characters_involved %} (Characters: {{ tp.characters_involved | join(' / ') }}){% endif %}
{% endfor %}{% endif %}
{% if blueprint.character_arcs %}

### Character Arcs
{% for arc in blueprint.character_arcs %}- **{{ arc.character }}**: {{ arc.arc_summary }}{% if arc.milestones %} | Milestones: {% for m in arc.milestones %}Chapter {{ m.chapter_start }}-{{ m.chapter_end }} "{{ m.description }}"{% if not loop.last %}; {% endif %}{% endfor %}{% endif %}
{% endfor %}{% endif %}
{% if blueprint.subplot_plan %}
### Subplot Weaving Relationships
{% for subplot in blueprint.subplot_plan %}
{% if subplot.weave_links %}
- Subplot "{{ subplot.name }}" weaving relationships:
{% for link in subplot.weave_links %}
  - {{ link.source_type }} "{{ link.source_ref }}" → {{ link.link_type }} → Chapter {{ link.trigger_chapter }} impact on "{{ link.target_subplot }}"
    ({{ link.description }})
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% if blueprint.ending_strategy %}

### Ending Strategy
{{ blueprint.ending_strategy }}
{% endif %}
{% endif %}

