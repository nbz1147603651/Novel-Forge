Compress the following chapter content into a high-density summary available for subsequent creative retrieval.

{{ render_summary_pass(summary_pass | default(''), source_scope | default('')) }}

{% if chapter_number | default(0) %}- Chapter: Chapter {{ chapter_number }}{% endif %}
{% if chapter_title | default('') %}- Title: {{ chapter_title }}{% endif %}
