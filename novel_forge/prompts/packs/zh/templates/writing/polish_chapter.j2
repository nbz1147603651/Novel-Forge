{%- import "_base/_render_style_profile_global.j2" as style_global -%}
{%- from "_base/_artifact_source_contract.j2" import render_artifact_source_contract -%}
{%- from "_base/_quality_calibration.j2" import render_quality_calibration, render_pre_delivery_checklist -%}
