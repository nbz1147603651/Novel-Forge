# Novel Forge active environment variables
# This file only keeps variables that are defined in novel_forge/core/config.py

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
NOVEL_FORGE_STORAGE_ROOT=./data

# -----------------------------------------------------------------------------
# API boundary
# -----------------------------------------------------------------------------
# Default is desktop/local-first: only trusted local Host headers and loopback
# clients are accepted. For LAN/server deployment, set local-only to false and
# configure a token plus the public host names you expect.
NOVEL_FORGE_API_TRUSTED_HOSTS=localhost,127.0.0.1,::1,testserver
NOVEL_FORGE_API_LOCAL_ONLY=true
NOVEL_FORGE_API_ACCESS_TOKEN=
NOVEL_FORGE_API_AUTH_EXEMPT_PATHS=/health

# -----------------------------------------------------------------------------
# Default model selection
# -----------------------------------------------------------------------------
NOVEL_FORGE_DEFAULT_MODEL_TIER=standard
NOVEL_FORGE_PREMIUM_MODEL=gpt-4o
NOVEL_FORGE_STANDARD_MODEL=gpt-4o-mini
# Historical tier name retained for compatibility; this is not a budget limiter.
NOVEL_FORGE_BUDGET_MODEL=gpt-3.5-turbo

# -----------------------------------------------------------------------------
# Provider keys
# Leave blank if unused. If no real provider is available, the app falls back
# to MockAdapter.
# -----------------------------------------------------------------------------
NOVEL_FORGE_OPENAI_API_KEY=
NOVEL_FORGE_ANTHROPIC_API_KEY=
NOVEL_FORGE_DEEPSEEK_API_KEY=
NOVEL_FORGE_TONGYI_API_KEY=
# 阿里百炼 Token Plan — 仅填 Token Plan 专属的 sk-sp- API Key；
# 运行时固定使用 https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1。
NOVEL_FORGE_TONGYI_TOKEN_PLAN_API_KEY=
NOVEL_FORGE_KIMI_API_KEY=
NOVEL_FORGE_MIMO_API_KEY=
# OpenCode Go - 开源模型聚合订阅 (https://opencode.ai/docs/zh-tw/go/)
# API key 从 https://opencode.ai/auth 获取; base URL 固定为 https://opencode.ai/zen/go/v1
NOVEL_FORGE_OPENCODE_API_KEY=
# 火山方舟 (Volcano Ark / Volcengine Ark) — Agent Plan 默认走
# https://ark.cn-beijing.volces.com/api/plan/v3 (智能体套餐)
# 也支持标准按量付费: NOVEL_FORGE_VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 也支持 BytePlus 区域: NOVEL_FORGE_VOLCENGINE_ARK_BASE_URL=https://ark.ap-southeast-1.volces.com/api/v3
NOVEL_FORGE_VOLCENGINE_ARK_API_KEY=
NOVEL_FORGE_VOLCENGINE_ARK_BASE_URL=
NOVEL_FORGE_VOLCENGINE_ARK_DEFAULT_MODEL=

# -----------------------------------------------------------------------------
# Default provider and per-task routing
# Example provider names: openai / anthropic / deepseek / tongyi / kimi / mimo / volcengine_ark / opencode
# Example task routing:
# {"draft_chapter":"tongyi:qwen-long","wave_chapter":"tongyi:qwen-long","extract_canon":"tongyi:qwen-plus"}
#
# NOTE: Task routing is managed via model_profiles.json (Desktop "火候" page).
# The fields below are ONLY used as a first-import seed when model_profiles.json
# does not exist. Once the JSON file is created, these values are ignored at
# runtime. The Desktop save action no longer writes routing back to .env.
# -----------------------------------------------------------------------------
NOVEL_FORGE_DEFAULT_PROVIDER=
NOVEL_FORGE_TASK_ROUTING=
# 任务级故障切换路由（可选）：
# 仅当主路由在超时/可重试错误下耗尽重试后，才会顺序切换到候选路由。
# 示例：
# NOVEL_FORGE_TASK_FALLBACK_ROUTING='{"draft_chapter":["tencent:hy3","deepseek:deepseek-v4-flash"],"repair_continuity":["tongyi:qwen-max"]}'
# 也支持火山方舟兜底: NOVEL_FORGE_TASK_FALLBACK_ROUTING='{"draft_chapter":["volcengine_ark:doubao-seed-2-0-pro-260215","deepseek:deepseek-chat"]}'
NOVEL_FORGE_TASK_FALLBACK_ROUTING=
NOVEL_FORGE_REPAIR_MODEL=

# -----------------------------------------------------------------------------
# Optional long-init web research
# -----------------------------------------------------------------------------
# Disabled per request by default; when enabled without a configured provider,
# the init flow writes a skipped report and continues.
NOVEL_FORGE_RESEARCH_ENABLED=false
NOVEL_FORGE_RESEARCH_DEFAULT_PROVIDER=auto
# Supported: auto/noop/tavily/brave/searxng/http_json/bailian_web_search/mcp_search.
# For SearXNG/http_json/百炼 set the endpoint explicitly; Tavily/Brave use built-in defaults.
# MCP uses the command/args/env settings below instead of this HTTP endpoint.
NOVEL_FORGE_RESEARCH_HTTP_ENDPOINT=
NOVEL_FORGE_RESEARCH_API_KEY=
NOVEL_FORGE_RESEARCH_TIMEOUT_S=10
NOVEL_FORGE_RESEARCH_MAX_QUERIES=3
NOVEL_FORGE_RESEARCH_RESULTS_PER_QUERY=5
NOVEL_FORGE_RESEARCH_MAX_RESULTS=5
NOVEL_FORGE_RESEARCH_RETRY_ATTEMPTS=1
NOVEL_FORGE_RESEARCH_INCLUDE_DOMAINS=
NOVEL_FORGE_RESEARCH_EXCLUDE_DOMAINS=
NOVEL_FORGE_RESEARCH_LOCALE=
NOVEL_FORGE_RESEARCH_SEARCH_DEPTH=basic
NOVEL_FORGE_RESEARCH_DOSSIER_ENABLED=true
NOVEL_FORGE_RESEARCH_DOSSIER_MAX_SOURCES=8
NOVEL_FORGE_OUTLINE_RESEARCH_GROUNDING_ENABLED=true
NOVEL_FORGE_OUTLINE_RESEARCH_GROUNDING_NOTES_PER_CHAPTER=3

# 后续大纲策略：fixed 保留原行为；proposal 只保存候选；adaptive 验证后自动发布。
NOVEL_FORGE_FUTURE_PLANNING_MODE=fixed
NOVEL_FORGE_FUTURE_PLANNING_WINDOW=4
# 探索前要求的日/月预算余量估计；实际调用仍受现有网关总预算约束。
NOVEL_FORGE_FUTURE_PLANNING_BUDGET_RESERVE_USD=1.0
NOVEL_FORGE_OUTLINE_RESEARCH_GROUNDING_BATCH_SIZE=6
NOVEL_FORGE_OUTLINE_RESEARCH_GROUNDING_PROMPT_CHAR_BUDGET=140000
NOVEL_FORGE_OUTLINE_RESEARCH_GROUNDING_COVERAGE_RETRIES=1
NOVEL_FORGE_RESEARCH_USE_LLM_PLANNING=true
NOVEL_FORGE_RESEARCH_MODEL_PRIOR_ENABLED=false
# Chapter runs reuse the provider above but remain separately gated. Each run
# creates at most one factual query and one low-frequency inspiration query.
NOVEL_FORGE_CHAPTER_RESEARCH_REFRESH_ENABLED=false
NOVEL_FORGE_CHAPTER_RESEARCH_INSPIRATION_ENABLED=false
NOVEL_FORGE_CHAPTER_RESEARCH_INSPIRATION_COOLDOWN=3
NOVEL_FORGE_CHAPTER_INTENT_GUARD_MODE=warn
# MCP search provider (mcp_search) settings:
# Command to launch the MCP server (e.g. uvx, npx). Required when provider=mcp_search.
NOVEL_FORGE_RESEARCH_MCP_COMMAND=
# Preferred JSON args. For uvx MiniMax use: ["minimax-coding-plan-mcp"]
NOVEL_FORGE_RESEARCH_MCP_ARGS_JSON=
# Note: NOVEL_FORGE_RESEARCH_API_KEY is auto-injected under NOVEL_FORGE_RESEARCH_MCP_API_KEY_ENV.
# Preferred JSON env, e.g. {"MINIMAX_API_HOST":"https://api.minimax.chat"}
NOVEL_FORGE_RESEARCH_MCP_ENV_JSON=
# Env var name expected by the selected MCP server for its API key. Blank disables injection.
NOVEL_FORGE_RESEARCH_MCP_API_KEY_ENV=MINIMAX_API_KEY
# Official MCP stdio uses newline framing; content_length is only for legacy local tools.
NOVEL_FORGE_RESEARCH_MCP_STDIO_FRAMING=newline
NOVEL_FORGE_RESEARCH_MCP_PROTOCOL_VERSION=2024-11-05
NOVEL_FORGE_RESEARCH_MCP_INHERIT_ENVIRONMENT=false
# Optional exact MCP tool name and tools/call argument mapping.
NOVEL_FORGE_RESEARCH_MCP_TOOL_NAME=
NOVEL_FORGE_RESEARCH_MCP_QUERY_ARGUMENT=query
# JSON object template; supports {query} and {results_per_query}.
NOVEL_FORGE_RESEARCH_MCP_TOOL_ARGUMENTS_JSON=

# -----------------------------------------------------------------------------
# Structured-output format repair
# -----------------------------------------------------------------------------
# UI-only raw JSON streaming; final parsing/repair/schema validation is unchanged.
NOVEL_FORGE_LONG_STREAMING_JSON_OBSERVATION_ENABLED=true
NOVEL_FORGE_LLM_FORMAT_RETRY_ATTEMPTS=2
NOVEL_FORGE_LLM_FORMAT_RETRY_TEMPERATURE=0.0
NOVEL_FORGE_LLM_FORMAT_RETRY_RAW_CHAR_LIMIT=6000
NOVEL_FORGE_CREATIVE_TEMPERATURE_JITTER_ENABLED=false
NOVEL_FORGE_CREATIVE_TEMPERATURE_JITTER_UP_DELTA=0.1
NOVEL_FORGE_CREATIVE_TEMPERATURE_JITTER_DOWN_DELTA=0.3
NOVEL_FORGE_CREATIVE_TEMPERATURE_JITTER_SCOPE=recommended
NOVEL_FORGE_CREATIVE_TEMPERATURE_JITTER_CUSTOM_TASKS=
NOVEL_FORGE_LLM_FORMAT_REPAIR_ENABLED=true
NOVEL_FORGE_LLM_FORMAT_REPAIR_MODEL=
NOVEL_FORGE_LLM_FORMAT_REPAIR_MAX_TOKENS=4096
NOVEL_FORGE_LLM_FORMAT_REPAIR_RAW_CHAR_LIMIT=60000

# -----------------------------------------------------------------------------
# Desktop appearance
# -----------------------------------------------------------------------------
# Theme ids: narrative_ember / ink_jade
NOVEL_FORGE_DESKTOP_THEME=narrative_ember
NOVEL_FORGE_DESKTOP_UI_FONT_FAMILY=source_sans
NOVEL_FORGE_DESKTOP_READING_FONT_FAMILY=source_serif
NOVEL_FORGE_DESKTOP_FONT_SCALE=1.0
NOVEL_FORGE_DESKTOP_PET_VISIBLE=true

# -----------------------------------------------------------------------------
# Desktop notifications
# -----------------------------------------------------------------------------
# Sound keys: mute / system / soft / chime / bell / alert
NOVEL_FORGE_DESKTOP_NOTIFICATION_SOUND_ENABLED=true
NOVEL_FORGE_DESKTOP_NOTIFICATION_SUCCESS_SOUND=chime
NOVEL_FORGE_DESKTOP_NOTIFICATION_DECISION_SOUND=bell
NOVEL_FORGE_DESKTOP_NOTIFICATION_FAILURE_SOUND=alert

# -----------------------------------------------------------------------------
# Pipeline defaults
# -----------------------------------------------------------------------------
NOVEL_FORGE_SHORT_MAX_EDIT_ROUNDS=2
NOVEL_FORGE_SHORT_ADAPTIVE_REVISION_ENABLED=false
NOVEL_FORGE_LONG_SINGLE_FINAL_VERIFY_ENABLED=false
NOVEL_FORGE_LONG_MAX_EDIT_ROUNDS=1

# Split large strict-JSON artifacts into anchored fragments, then merge locally.
NOVEL_FORGE_SPLIT_TASKS_ENABLED=true
# Default for the workflow page's per-project blueprint mode selector.
NOVEL_FORGE_INIT_FRAGMENT_MAX_PARALLEL=4
NOVEL_FORGE_LONG_SCENE_DRAFT_MAX_PARALLEL=5
NOVEL_FORGE_INIT_CHARACTER_PROFILE_PARALLEL_MIN_ROSTER=11
NOVEL_FORGE_INIT_CHARACTER_PROFILE_BATCH_SIZE=5
# 0 = auto-size outline/contract batches from the routed model output limit.
NOVEL_FORGE_OUTLINE_BATCH_SIZE=0
NOVEL_FORGE_INIT_OUTLINE_BEATS_MIN=4
NOVEL_FORGE_INIT_OUTLINE_BEATS_MAX=8
NOVEL_FORGE_INIT_OUTLINE_MAIN_PLOT_POINTS_MIN=2
NOVEL_FORGE_INIT_OUTLINE_MAIN_PLOT_POINTS_MAX=4
NOVEL_FORGE_INIT_OUTLINE_SUBPLOT_POINTS_MAX=3
NOVEL_FORGE_INIT_OUTLINE_ELEMENT_FOCUS_MAX=3
NOVEL_FORGE_INIT_OUTLINE_EXPECTED_PAYOFFS_MIN=1
NOVEL_FORGE_INIT_OUTLINE_EXPECTED_PAYOFFS_MAX=3
NOVEL_FORGE_CHAPTER_CONTRACT_BATCH_SIZE=0
NOVEL_FORGE_CANON_EXTRACT_MAX_PARALLEL=4
NOVEL_FORGE_BOOK_AUDIT_MAX_PARALLEL=3
NOVEL_FORGE_PATCH_FIRST_REPAIR=true

NOVEL_FORGE_LONG_ALIGNMENT_THRESHOLD=7.0

NOVEL_FORGE_LONG_VOLUME_AUTO_CHAPTER_THRESHOLD=60
NOVEL_FORGE_LONG_VOLUME_AUTO_WORD_THRESHOLD=250000
NOVEL_FORGE_LONG_DEFAULT_CHAPTERS_PER_VOLUME=20

# free / balanced / strict / ai_judge
NOVEL_FORGE_LONG_PLOT_GUARD_MODE=balanced
NOVEL_FORGE_LONG_AI_JUDGE_MAX_CONTEXT_CHAPTERS=24
NOVEL_FORGE_LONG_AI_JUDGE_MAX_TOKENS=1536
NOVEL_FORGE_LONG_AI_JUDGE_APPLY_ENTITY_ACTIONS=true
# assist / trust
NOVEL_FORGE_LONG_AI_JUDGE_APPLY_MODE=assist

# Conservative pipeline efficiency shortcuts. These never weaken archive hard
# gates; uncertain cases fall back to the full audit/evaluation/repair path.
NOVEL_FORGE_LONG_KB_AUDIT_REUSE_ENABLED=true
NOVEL_FORGE_LONG_EVAL_REUSE_ENABLED=true
NOVEL_FORGE_LONG_CAUSAL_HIGH_SCORE_SKIP_ENABLED=true
NOVEL_FORGE_LONG_CAUSAL_SKIP_THRESHOLD=9.5

# Prompt/context controls
NOVEL_FORGE_LONG_AUTO_INTRODUCE_MAX_NEW_CHARACTERS=2
NOVEL_FORGE_LONG_PROMPT_MAX_CHARACTER_PROFILES=8
NOVEL_FORGE_LONG_PROMPT_MAX_PROFILE_FIELD_CHARS=240
NOVEL_FORGE_LONG_PROMPT_PROFILE_SOURCE_FIELD_CHARS=900
NOVEL_FORGE_LONG_PROMPT_MAX_RELATIONSHIPS_PER_PROFILE=6
NOVEL_FORGE_LONG_PLAN_PREV_REPORT_MAX_DEVIATIONS=2
NOVEL_FORGE_LONG_PLAN_PREV_REPORT_MAX_NEW_CHARACTERS=3
NOVEL_FORGE_LONG_PLAN_PREV_REPORT_TEXT_CHARS=260
NOVEL_FORGE_LONG_PLAN_PREV_REPORT_SOURCE_CHARS=1200
NOVEL_FORGE_LONG_CONTEXT_COMPRESS_ENABLED=true
NOVEL_FORGE_LONG_CHECK_CHAPTER_ENABLED=true
NOVEL_FORGE_LONG_CONTEXT_COMPRESS_MIN_CHARS=220
NOVEL_FORGE_LONG_CONTEXT_COMPRESS_MAX_TOKENS=2048

# Archive policy. Keep subjective reader-pull checks soft by default, but block
# chapters that fall below the extreme floor.
# Set this to false to skip target-word-count restructuring/blocking before archive.
# Empty/critically short chapter protection still remains active.
NOVEL_FORGE_LONG_WORD_COUNT_ARCHIVE_GATE_ENABLED=true
# inherit / enforce / warn. inherit follows NOVEL_FORGE_LONG_WORD_COUNT_ARCHIVE_GATE_ENABLED.
NOVEL_FORGE_LONG_WAVE_WORD_COUNT_POLICY=inherit
# WAVE output below this draft-word ratio is treated as regressed and skipped.
NOVEL_FORGE_LONG_WAVE_REGRESSION_FLOOR_RATIO=0.4
# off / floor_only / floor_or_core_high
NOVEL_FORGE_LONG_READING_POWER_ARCHIVE_POLICY=floor_only
NOVEL_FORGE_LONG_READING_POWER_HARD_BLOCK_THRESHOLD=3.0
NOVEL_FORGE_LONG_READING_POWER_ARCHIVE_BLOCK_ISSUE_TYPES='["hook_missing","prev_hook_unfulfilled"]'
# warn / block_actionable
NOVEL_FORGE_LONG_GUARD_ARCHIVE_POLICY=warn
NOVEL_FORGE_LONG_GUARD_ARCHIVE_BLOCK_STATUSES='["non_compliant"]'
NOVEL_FORGE_LONG_GUARD_ARCHIVE_BLOCK_MIN_CONFIDENCE=0.8

# Chapter compact
NOVEL_FORGE_LONG_CHAPTER_COMPACT_INTERVAL=5
NOVEL_FORGE_LONG_CHAPTER_COMPACT_START_CHAPTER=10
NOVEL_FORGE_LONG_CHAPTER_COMPACT_STALE_CHAPTERS=8
NOVEL_FORGE_LONG_CHAPTER_COMPACT_OUTLINE_LOOKAHEAD=12
NOVEL_FORGE_LONG_CHAPTER_COMPACT_MIN_ACTIVE_CHARACTERS=8
NOVEL_FORGE_LONG_CHAPTER_COMPACT_TARGET_WORLD_FACTS=120
NOVEL_FORGE_LONG_CHAPTER_COMPACT_KEEP_RECENT_WORLD_FACTS=40
NOVEL_FORGE_LONG_CHAPTER_COMPACT_ARCHIVE_RESOLVED_FORESHADOWING_AFTER=6

NOVEL_FORGE_LONG_PLAN_BEATS_MIN=4
NOVEL_FORGE_LONG_PLAN_BEATS_MAX=8
NOVEL_FORGE_LONG_PLAN_BEAT_MAX_CHARS=260

NOVEL_FORGE_LONG_ADJUST_OUTLINE_MAX_CHAPTERS_CONTEXT=30

# Canon context caps
NOVEL_FORGE_CANON_CONTEXT_MAX_RECENT_EVENTS=40
NOVEL_FORGE_CANON_CONTEXT_MAX_CHARACTERS=15
NOVEL_FORGE_CANON_CONTEXT_MAX_FORESHADOWING=30
NOVEL_FORGE_CANON_CONTEXT_MAX_WORLD_FACTS=80

# Chapter generation attention budget
# Cross-chapter boundary window. Bridge owns the handoff; Edit/Polish review
# and Repair leak handling reuse the same paragraph windows.
NOVEL_FORGE_LONG_BOUNDARY_PREV_TAIL_PARAGRAPHS=5
NOVEL_FORGE_LONG_BOUNDARY_OPENING_PARAGRAPHS=3
NOVEL_FORGE_LONG_DRAFT_PROMPT_DIAGNOSTICS_ENABLED=true
NOVEL_FORGE_LONG_DRAFT_PROMPT_WARN_TOKENS=32000
NOVEL_FORGE_LONG_PROMPT_DIAGNOSTICS_ENABLED=true
NOVEL_FORGE_LONG_PROMPT_PREFLIGHT_BLOCK_OVERSIZED=true
NOVEL_FORGE_LONG_PROMPT_WARN_TOKENS=32000

# Repair Orchestration v2 control mode: manual / ai_assisted / ai_auto.
# Protocol-only format_response repair is validator-gated and not blocked by this mode.
NOVEL_FORGE_REPAIR_CONTROL_MODE=ai_assisted

# LLM-adjudicated narrative state
NOVEL_FORGE_NARRATIVE_STATE_ENABLED=true
NOVEL_FORGE_NARRATIVE_STATE_REQUIRED=true
NOVEL_FORGE_NARRATIVE_STATE_MAX_REPAIR_ROUNDS=1
NOVEL_FORGE_NARRATIVE_STATE_CANDIDATE_MAX_COUNT=8
NOVEL_FORGE_NARRATIVE_STATE_PENDING_TAIL_ITEMS=6

# Initialization coherence gates
NOVEL_FORGE_CHAPTER_CONTRACT_CONTEXT_WINDOW=2
NOVEL_FORGE_CHAPTER_CONTRACT_ENTITY_CATALOG_MAX_ENTITIES=96
NOVEL_FORGE_CHAPTER_CONTRACT_DYNAMIC_BUDGET_ENABLED=true
NOVEL_FORGE_CHAPTER_CONTRACT_HARD_WORDS_PER_ITEM=1000
NOVEL_FORGE_CHAPTER_CONTRACT_HARD_MIN_ITEMS=3
NOVEL_FORGE_CHAPTER_CONTRACT_HARD_MAX_ITEMS=6
NOVEL_FORGE_CHAPTER_CONTRACT_SOFT_WORDS_PER_ITEM=900
NOVEL_FORGE_CHAPTER_CONTRACT_SOFT_MAX_ITEMS=5
NOVEL_FORGE_CHAPTER_CONTRACT_STATE_WORDS_PER_ITEM=1200
NOVEL_FORGE_CHAPTER_CONTRACT_STATE_MAX_ITEMS=4
NOVEL_FORGE_CONTRACT_COHERENCE_BATCH_SIZE=12
NOVEL_FORGE_CONTRACT_COHERENCE_CONTEXT_WINDOW=2
NOVEL_FORGE_CONTRACT_COHERENCE_MAX_PARALLEL=2
NOVEL_FORGE_INIT_COHERENCE_GATE_ENABLED=true
NOVEL_FORGE_INIT_COHERENCE_V2_ENABLED=true
NOVEL_FORGE_INIT_COHERENCE_USE_MEMORY=true
NOVEL_FORGE_INIT_COHERENCE_CLAIM_BATCH_SIZE=8
NOVEL_FORGE_INIT_COHERENCE_CLAIM_PAYLOAD_CHAR_BUDGET=18000
NOVEL_FORGE_INIT_COHERENCE_CLAIM_MAX_PARALLEL=2
NOVEL_FORGE_INIT_BLUEPRINT_HOLISTIC_CLAIMS_ENABLED=true
NOVEL_FORGE_INIT_BLUEPRINT_HOLISTIC_CLAIM_MAX_TOKENS=4096
NOVEL_FORGE_INIT_STREAM_CLAIM_PREFETCH_ENABLED=true
NOVEL_FORGE_INIT_COHERENCE_OVERLAP_CHAPTERS=2
NOVEL_FORGE_INIT_COHERENCE_SEMANTIC_TOP_K=12
NOVEL_FORGE_INIT_COHERENCE_CANDIDATE_MAX_PER_BATCH=80
NOVEL_FORGE_INIT_COHERENCE_LLM_CANDIDATE_BATCH_SIZE=12
NOVEL_FORGE_INIT_COHERENCE_LLM_CANDIDATE_MAX_PARALLEL=2
NOVEL_FORGE_INIT_ENTITY_REFERENCE_BATCH_EVIDENCE_TOKEN_BUDGET=3600
NOVEL_FORGE_INIT_COHERENCE_CONFIDENCE_THRESHOLD=0.75
NOVEL_FORGE_INIT_COHERENCE_RECHECK_AFFECTED_WINDOW=2
NOVEL_FORGE_INIT_COHERENCE_AUTO_REPAIR=true
NOVEL_FORGE_INIT_COHERENCE_DETERMINISTIC_REPAIR=true
NOVEL_FORGE_INIT_COHERENCE_MAX_REPAIR_ROUNDS=2
NOVEL_FORGE_INIT_COHERENCE_BLOCK_MIN_SEVERITY=high
NOVEL_FORGE_INIT_COHERENCE_PATCH_MAX_OPS=40
NOVEL_FORGE_INIT_CLAIM_COVERAGE_ENABLED=true
NOVEL_FORGE_INIT_CLAIM_COVERAGE_BLOCK_P0=true
NOVEL_FORGE_INIT_CLAIM_COVERAGE_BLOCK_P1=false
NOVEL_FORGE_INIT_DISABLE_LOCAL_STORY_FALLBACKS=true
NOVEL_FORGE_INIT_CREATIVE_REFINEMENT_ENABLED=false
NOVEL_FORGE_INIT_CREATIVE_REFINEMENT_AUTO_APPLY_LOW_RISK=true
NOVEL_FORGE_INIT_ADAPTIVE_CREATIVE_EXPLORATION_ENABLED=true
NOVEL_FORGE_INIT_PROGRESSIVE_PLANNING_ENABLED=true
NOVEL_FORGE_INIT_READINESS_REQUIRED=true

# -----------------------------------------------------------------------------
# StoryKernel (SQLite-backed narrative state)
# -----------------------------------------------------------------------------
NOVEL_FORGE_STORY_KERNEL_DB_PATH=
NOVEL_FORGE_STORY_KERNEL_WAL_MODE=true
NOVEL_FORGE_STORY_KERNEL_ZVEC_ENABLED=false

# -----------------------------------------------------------------------------
# TTS / 配音工作室
# -----------------------------------------------------------------------------
# 跨项目复用的声音资源根目录。留空时使用系统的 Novel Forge 应用数据目录；
# 源码运行的模型统一保存在仓库根目录的 gitignored models/ 下。
# NOVEL_FORGE_APPLICATION_DATA_ROOT=/Volumes/NovelForgeData
NOVEL_FORGE_TTS_ENABLED=false
NOVEL_FORGE_TTS_DEFAULT_PROVIDER=minimax
NOVEL_FORGE_TTS_DEFAULT_MODEL=speech-2.8-hd
NOVEL_FORGE_TTS_AUTO_TRIGGER_AFTER_CHAPTER=false
# post-archive TTS 失败后延迟 60s 自动重试一次（仅针对 pending_approval / expired）。
NOVEL_FORGE_TTS_POST_ARCHIVE_RETRY_ENABLED=true
NOVEL_FORGE_TTS_POST_ARCHIVE_RETRY_DELAY_S=60
# 全局音色库匹配范围：project_only（仅本项目）/ global_with_names（跨项目同名复用）/ global_all。
NOVEL_FORGE_TTS_VOICE_LIBRARY_SCOPE=project_only
# 试听不会无限等待自动配音占用的项目锁；超时后界面会提示稍后重试。
NOVEL_FORGE_TTS_PREVIEW_LOCK_WAIT_TIMEOUT_S=8
# 单次交互试听等待平台返回音频的最长秒数。
NOVEL_FORGE_TTS_PREVIEW_SYNTHESIS_TIMEOUT_S=45
NOVEL_FORGE_TTS_VOICE_DESIGN_ENABLED=true
# 默认关闭：只为低置信度的音色库/系统音色匹配增加一次建议型 LLM 复核，
# 不会突破性别、年龄、供应商与有效期硬约束，也不会静默替换角色音色。
NOVEL_FORGE_TTS_VOICE_LLM_ADJUDICATION_ENABLED=false
NOVEL_FORGE_TTS_VOICE_LLM_ADJUDICATION_MIN_MATCH_SCORE=0.72
NOVEL_FORGE_TTS_VOICE_LLM_ADJUDICATION_MAX_CANDIDATES=4
NOVEL_FORGE_TTS_VOICE_LLM_ADJUDICATION_CHOICES_PER_CHARACTER=4
NOVEL_FORGE_TTS_VOICE_LLM_ADJUDICATION_AUTO_SELECT_SCORE=0.85
NOVEL_FORGE_TTS_VOICE_LLM_ADJUDICATION_MAX_OUTPUT_TOKENS=1200
# 配音脚本专用审校独立于小说审查：小说 Humanize 只提供候选信号，
# 审校仅自动调整安全的情绪/语气/副语言标注；正文、声音角色或说话人风险转人工复核。
NOVEL_FORGE_TTS_SCRIPT_LLM_REVIEW_ENABLED=true
NOVEL_FORGE_TTS_SCRIPT_LLM_REVIEW_MAX_OUTPUT_TOKENS=8192
# 配音 LLM 任务的温度与采样参数：脚本生成平衡稳定与创造性（0.5），口语改写适度（0.45），
# 审校/裁决低温（0.0），声音设计适度提高（0.5）以增加创意多样性；可在桌面设置页「脚本审校与声音设计」分区微调。
NOVEL_FORGE_TTS_SCRIPT_GENERATION_TEMPERATURE=0.5
NOVEL_FORGE_TTS_SCRIPT_GENERATION_TOP_P=0.95
NOVEL_FORGE_TTS_SPOKEN_REWRITE_TEMPERATURE=0.45
# 口语改写的候选、批次、语义验证和上下文均由配置驱动；模板读取同一份策略，
# 避免提示词限制与运行时验收标准漂移。
NOVEL_FORGE_TTS_SPOKEN_REWRITE_BATCH_SIZE=30
NOVEL_FORGE_TTS_SPOKEN_REWRITE_MIN_LENGTH=8
NOVEL_FORGE_TTS_SPOKEN_REWRITE_MIN_LENGTH_RATIO=0.5
NOVEL_FORGE_TTS_SPOKEN_REWRITE_MAX_LENGTH_RATIO=1.3
NOVEL_FORGE_TTS_SPOKEN_REWRITE_MIN_SEQUENCE_RATIO=0.35
NOVEL_FORGE_TTS_SPOKEN_REWRITE_MIN_CONFIDENCE=0.6
NOVEL_FORGE_TTS_SPOKEN_REWRITE_CONTEXT_WINDOW=1
NOVEL_FORGE_TTS_SPOKEN_REWRITE_NARRATION_SENTENCE_CHARS=30
NOVEL_FORGE_TTS_SPOKEN_REWRITE_DIALOGUE_SENTENCE_CHARS=20
NOVEL_FORGE_TTS_SPOKEN_REWRITE_INNER_THOUGHT_SENTENCE_CHARS=25
NOVEL_FORGE_TTS_SPOKEN_REWRITE_MIN_OUTPUT_TOKENS=1024
NOVEL_FORGE_TTS_SPOKEN_REWRITE_OUTPUT_TOKENS_PER_SEGMENT=160
# 非正文上游资料采用按步骤投影，并限制单节条目数和文本长度。
NOVEL_FORGE_TTS_SCRIPT_CONTEXT_MAX_ITEMS=8
NOVEL_FORGE_TTS_SCRIPT_CONTEXT_MAX_TEXT_CHARS=240
NOVEL_FORGE_TTS_REVIEW_ADJUDICATION_TEMPERATURE=0.0
NOVEL_FORGE_TTS_NARRATOR_PROFILE_TEMPERATURE=0.2
NOVEL_FORGE_TTS_SOUND_DESIGN_TEMPERATURE=0.5
NOVEL_FORGE_TTS_SOUND_DESIGN_TOP_P=0.95
NOVEL_FORGE_TTS_MAX_CONCURRENT_SYNTHESIS=4
# 远程 TTS 请求会均匀排队；每次重试也会计入该额度。
NOVEL_FORGE_TTS_SYNTHESIS_REQUESTS_PER_MINUTE=45
# 服务商返回 RPM 限流后，暂停整条远程合成队列。
NOVEL_FORGE_TTS_SYNTHESIS_RATE_LIMIT_COOLDOWN_S=60
NOVEL_FORGE_TTS_SYNTHESIS_RETRY_LIMIT=3
NOVEL_FORGE_TTS_OUTPUT_FORMAT=mp3
# 项目内仅保存成品音频和素材；模型权重必须放在应用级模型库。
NOVEL_FORGE_TTS_PROJECT_MAX_STORAGE_MB=1024
NOVEL_FORGE_TTS_PROJECT_MAX_FILE_MB=256
NOVEL_FORGE_TTS_SAMPLE_RATE=32000
NOVEL_FORGE_TTS_NARRATOR_VOICE_ID=
# 映界 MiniMax H3 v2（与 TTS 凭据分离）
NOVEL_FORGE_FILM_DEFAULT_PROVIDER=minimax
NOVEL_FORGE_FILM_MINIMAX_API_KEY=
NOVEL_FORGE_FILM_MINIMAX_BASE_URL=https://api.minimaxi.com
NOVEL_FORGE_FILM_PROJECT_BUDGET_USD=50

NOVEL_FORGE_TTS_MINIMAX_API_KEY=
NOVEL_FORGE_TTS_MINIMAX_GROUP_ID=
NOVEL_FORGE_TTS_MINIMAX_BITRATE=128000
NOVEL_FORGE_TTS_MINIMAX_CHANNEL=1
NOVEL_FORGE_TTS_MINIMAX_LANGUAGE_BOOST=auto
NOVEL_FORGE_TTS_DASHSCOPE_API_KEY=
NOVEL_FORGE_TTS_DASHSCOPE_MODEL=qwen-audio-3.0-tts-plus
# 留空表示试听沿用正式模型；自定义音色仍强制使用其绑定模型。
NOVEL_FORGE_TTS_DASHSCOPE_PREVIEW_MODEL=
NOVEL_FORGE_TTS_DASHSCOPE_VOICE_DESIGN_MODEL=cosyvoice-v3.5-plus
NOVEL_FORGE_TTS_DASHSCOPE_VOICE_CLONE_MODEL=qwen-audio-3.0-tts-plus
# 生产环境优先使用百炼业务空间专属域名，例如：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
NOVEL_FORGE_TTS_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Qwen3 Instruct 开启指令语义优化；做严格 A/B 时可关闭。
NOVEL_FORGE_TTS_DASHSCOPE_OPTIMIZE_INSTRUCTIONS=true
# 只有参考录音含明显噪声时才建议开启。
NOVEL_FORGE_TTS_DASHSCOPE_VOICE_CLONE_ENABLE_PREPROCESS=false
NOVEL_FORGE_TTS_DASHSCOPE_CNY_PER_USD=7.2
NOVEL_FORGE_TTS_TENCENT_SECRET_ID=
NOVEL_FORGE_TTS_TENCENT_SECRET_KEY=
# 火山方舟 Agent Plan 豆包语音 2.0：复用上方的
# NOVEL_FORGE_VOLCENGINE_ARK_API_KEY（Agent Plan 个人版专属 Key）。
NOVEL_FORGE_TTS_VOLCENGINE_MODEL=doubao-seed-tts-2.0
NOVEL_FORGE_TTS_VOLCENGINE_RESOURCE_ID=seed-tts-2.0
NOVEL_FORGE_TTS_VOLCENGINE_BASE_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
# MiMo TTS 使用开放平台普通 API Key，不使用 Token Plan 专用地址。
NOVEL_FORGE_TTS_MIMO_API_KEY=
NOVEL_FORGE_TTS_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
NOVEL_FORGE_TTS_MIMO_MODEL=mimo-v2.5-tts
# 本地开源 TTS（Qwen3-TTS / CosyVoice / Fish Speech / GPT-SoVITS）：
# 必须支持 POST /v1/audio/speech；可选支持
# GET /v1/capabilities、GET /v1/voices、POST /v1/voices/clone、POST /v1/voices/design。
NOVEL_FORGE_TTS_LOCAL_BASE_URL=http://localhost:8000/v1
NOVEL_FORGE_TTS_LOCAL_API_KEY=
NOVEL_FORGE_TTS_LOCAL_MODEL=default
# Qwen3-TTS：使用本项目提供的隔离 sidecar。正式合成、快速试听、音色设计和授权克隆
# 分别对应官方 CustomVoice 1.7B、CustomVoice 0.6B、VoiceDesign 1.7B、Base 1.7B。
NOVEL_FORGE_TTS_QWEN3_BASE_URL=http://127.0.0.1:8011/v1
NOVEL_FORGE_TTS_QWEN3_API_KEY=
NOVEL_FORGE_TTS_QWEN3_FORMAL_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
NOVEL_FORGE_TTS_QWEN3_PREVIEW_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
NOVEL_FORGE_TTS_QWEN3_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
NOVEL_FORGE_TTS_QWEN3_CLONE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# 原生 CosyVoice 3：直接对接官方 FastAPI `/inference_*`，不使用 OpenAI 兼容层。
NOVEL_FORGE_TTS_COSYVOICE_BASE_URL=http://127.0.0.1:50000
NOVEL_FORGE_TTS_COSYVOICE_MODEL=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
# instruct2 适合“参考声纹 + 角色特质指令”；zero_shot 需要填写参考音频逐字转写。
NOVEL_FORGE_TTS_COSYVOICE_MODE=instruct2
# 留空时保存到应用级可复用声纹库；不要放到 data/<项目>/。
NOVEL_FORGE_TTS_COSYVOICE_VOICE_STORE=
NOVEL_FORGE_TTS_COSYVOICE_SAMPLE_RATE=22050
# 原生 OpenVoice V2：使用 OpenVoice + MeloTTS Python 运行时和 checkpoints_v2。
NOVEL_FORGE_TTS_OPENVOICE_MODEL=openvoice-v2
NOVEL_FORGE_TTS_OPENVOICE_CHECKPOINT_DIR=
NOVEL_FORGE_TTS_OPENVOICE_VOICE_STORE=
NOVEL_FORGE_TTS_OPENVOICE_DEVICE=auto
NOVEL_FORGE_TTS_OPENVOICE_LANGUAGE=ZH

# 能力驱动的音频模型计划。普通用户只需选择质量预设；高级用户可以用 JSON
# 固定单个阶段，例如 {"forced_aligner":"qwen3-forced-aligner-0.6b"}。
NOVEL_FORGE_AUDIO_QUALITY_PRESET=production
NOVEL_FORGE_AUDIO_LOCATION_POLICY=hybrid
NOVEL_FORGE_AUDIO_ACCELERATOR_PREFERENCE=auto
NOVEL_FORGE_AUDIO_MEMORY_BUDGET=medium
NOVEL_FORGE_LOCAL_MODEL_RESOURCE_BUDGET=medium
NOVEL_FORGE_LOCAL_MODEL_RESOURCE_WAIT_TIMEOUT_S=900
NOVEL_FORGE_AUDIO_PLUGIN_OVERRIDES={}
NOVEL_FORGE_AUDIO_LANGUAGE_OVERRIDES={}
NOVEL_FORGE_AUDIO_DISABLED_PLUGINS=
NOVEL_FORGE_AUDIO_PLUGIN_MANIFEST_DIRS=
NOVEL_FORGE_AUDIO_DUAL_ALIGNMENT_VALIDATION=false
# 各模型保持独立运行环境；主进程只调用统一的 health/capabilities/transcribe/align 接口。
NOVEL_FORGE_AUDIO_QWEN3_ASR_BASE_URL=http://127.0.0.1:8012/v1
NOVEL_FORGE_AUDIO_QWEN3_ASR_API_KEY=
NOVEL_FORGE_AUDIO_WHISPERX_BASE_URL=http://127.0.0.1:8013/v1
NOVEL_FORGE_AUDIO_SHERPA_BASE_URL=http://127.0.0.1:8014/v1
# NOVEL_FORGE_AUDIO_MODELS_ROOT=./models/audio
NOVEL_FORGE_TTS_SEGMENT_QUALITY_ENABLED=true
NOVEL_FORGE_TTS_SEGMENT_MIN_DURATION_MS=100
NOVEL_FORGE_TTS_SEGMENT_MAX_CHARACTERS_PER_SECOND=20
NOVEL_FORGE_TTS_ALIGNMENT_REPAIR_ROUNDS=1
NOVEL_FORGE_TTS_MIN_ALIGNMENT_COVERAGE=0.85
NOVEL_FORGE_TTS_MAX_TEXT_ERROR_RATE=0.12
NOVEL_FORGE_TTS_MASTER_QUALITY_GATE_BLOCKING=true
NOVEL_FORGE_AUDIO_MFA_COMMAND=mfa

# -----------------------------------------------------------------------------
# 生成式声音资产（BGM / 环境声 / 短音效）
# -----------------------------------------------------------------------------
# 默认关闭：先通过配音脚本和导入素材验证声音设计；开启 auto_generate 会对缺失提示调用模型。
# 配音推进模式：manual（全人工）/ assisted（AI 伴随）/ autonomous（全 AI 自主）
NOVEL_FORGE_TTS_AUTOMATION_MODE=assisted
# 以下三项由推进模式派生，保留仅用于兼容旧配置和底层诊断
NOVEL_FORGE_SOUND_GENERATION_ENABLED=false
NOVEL_FORGE_SOUND_GENERATION_AUTO_GENERATE=false
# false 时生成资产会进入声音资产库但标记为待审核，不会自动进入章节混音。
NOVEL_FORGE_SOUND_GENERATION_AUTO_APPROVE=false
# auto：长环境声 / BGM 使用 MiniMax；短 SFX 使用本地 Stable Audio 3 Small-SFX。
NOVEL_FORGE_SOUND_GENERATION_DEFAULT_PROVIDER=auto
NOVEL_FORGE_SOUND_GENERATION_MAX_DURATION_S=120
NOVEL_FORGE_SOUND_GENERATION_OUTPUT_FORMAT=wav
NOVEL_FORGE_SOUND_GENERATION_TIMEOUT_S=300
# MiniMax Music 2.6（仅用于无歌词 BGM）；为空时回退 TTS / LLM MiniMax Key。
NOVEL_FORGE_SOUND_GENERATION_MINIMAX_API_KEY=
NOVEL_FORGE_SOUND_GENERATION_MINIMAX_MUSIC_ENDPOINT=https://api.minimax.io/v1/music_generation
NOVEL_FORGE_SOUND_GENERATION_MINIMAX_MUSIC_MODEL=music-2.6
# Stable Audio 3 本地 CLI。第一阶段仅管理和使用 small-sfx；small-music 为后续阶段预留。
NOVEL_FORGE_SOUND_GENERATION_STABLE_AUDIO_COMMAND=stable-audio
# 本机共享模型库；留空/不设置时使用 Novel Forge 的可写应用目录。只有磁盘空间不足时才取消注释并改为其他本机磁盘。
# NOVEL_FORGE_SOUND_GENERATION_STABLE_AUDIO_MODELS_DIR=/Volumes/Media/NovelForge/models/audio/stable-audio
# Small-SFX/Small-Music 需先在 Hugging Face 接受条款；可填写具有访问权限的 Token。
NOVEL_FORGE_SOUND_GENERATION_HUGGINGFACE_TOKEN=
NOVEL_FORGE_SOUND_GENERATION_STABLE_AUDIO_SFX_MODEL=small-sfx
NOVEL_FORGE_SOUND_GENERATION_STABLE_AUDIO_MUSIC_MODEL=small-music

# -----------------------------------------------------------------------------
# Memory module
# -----------------------------------------------------------------------------
NOVEL_FORGE_MEMORY_EPISODIC_ENABLED=true
NOVEL_FORGE_MEMORY_EMBEDDING_PROFILE_ID=
NOVEL_FORGE_MEMORY_USE_MOCK_EMBEDDINGS=false
# zvec is the production backend; in_memory is only for tests/mock embeddings.
NOVEL_FORGE_MEMORY_VECTOR_STORE_BACKEND=zvec
# hnsw / ivf / flat / hnsw_rabitq / diskann
NOVEL_FORGE_MEMORY_ZVEC_INDEX_TYPE=hnsw
NOVEL_FORGE_MEMORY_ZVEC_MEMORY_LIMIT_MB=512
NOVEL_FORGE_MEMORY_SEMANTIC_SEARCH_ENABLED=true
NOVEL_FORGE_MEMORY_MULTI_GRANULARITY_SUMMARY_ENABLED=true
NOVEL_FORGE_MEMORY_CHAPTER_SUMMARY_TARGET_WORDS=200
NOVEL_FORGE_MEMORY_VOLUME_SUMMARY_TARGET_WORDS=1000
NOVEL_FORGE_MEMORY_SUMMARY_INPUT_TOKEN_BUDGET=24000
NOVEL_FORGE_MEMORY_SUMMARY_RECENT_CHAPTERS=5
NOVEL_FORGE_MEMORY_ADAPTIVE_COMPRESSION_ENABLED=true
NOVEL_FORGE_MEMORY_MOTIF_TRACKING_ENABLED=true
NOVEL_FORGE_MEMORY_MOTIF_CHECK_REPETITION=true
NOVEL_FORGE_MEMORY_CONCURRENT_INDEXING=true

