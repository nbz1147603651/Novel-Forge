# -----------------------------------------------------------------------------
# Logging / API
# -----------------------------------------------------------------------------
NOVEL_FORGE_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API timeouts (seconds)
# Connect timeout covers TCP/TLS establishment; call timeout covers the full response.
# Increase connect timeout for slow proxies or unstable cross-region networking.
# -----------------------------------------------------------------------------
NOVEL_FORGE_API_CONNECT_TIMEOUT_S=30
NOVEL_FORGE_API_CALL_TIMEOUT_S=900
